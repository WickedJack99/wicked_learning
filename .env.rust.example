# Local proof-of-concept settings only. Supply strong unique values outside
# version control before using this Compose file in any shared environment.
RUST_FRONTEND_PORT=8081
APPLICATION_DATABASE_PASSWORD=wicked-local-development-only
CSRF_COOKIE_KEY=wicked-local-development-only-csrf-cookie-key-replace-before-a-shared-deployment-0000
IDENTITY_DATABASE_PASSWORD=wicked-local-development-only
# Static only for disposable local development. Use a distinct Base64-encoded
# 32-byte value in every shared environment and keep it stable while rate-limit
# rows may exist.
LOGIN_RATE_LIMIT_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
PUBLIC_ORIGIN=http://localhost:8081
RUST_LOG=info
# Static only for disposable local development. Use a distinct Base64-encoded
# 32-byte value in any shared environment and retain it for existing TOTP data.
TOTP_ENCRYPTION_KEY=d2lja2VkLWxlYXJuaW5nLWxvY2FsLXRvdHAta2V5LTA=
# Static only for disposable local development. Use a distinct Base64-encoded
# 32-byte key in every shared environment and retain it for existing encrypted
# provider credentials.
AI_CREDENTIAL_ENCRYPTION_KEY=d2lja2VkLWxlYXJuaW5nLWxvY2FsLWFpLWtleS0wMDE=
