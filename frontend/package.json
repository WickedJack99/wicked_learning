{
  "name": "wicked-learning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run check:canonical-source && npm run generate:api && tsc --noEmit && vite build",
    "check:api": "npm run generate:api && git diff --exit-code -- src/platform/api/schema.ts",
    "check:canonical-source": "node scripts/verify-canonical-source.mjs",
    "dev": "vite",
    "generate:api": "openapi-typescript ../contracts/openapi/v1.yaml -o src/platform/api/schema.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@inertiajs/react": "^3.11.0",
    "@laravel/passkeys": "^0.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "1.3.4",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "2.3.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.475.0",
    "openapi-fetch": "0.17.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
