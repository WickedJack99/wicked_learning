{
  "name": "wicked-learning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run generate:api && tsc --noEmit && vite build",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.ts",
    "dev": "vite",
    "generate:api": "openapi-typescript ../contracts/openapi/v1.yaml -o src/api/schema.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
