{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@laravel/passkeys/react": ["src/platform/passkey-react.ts"],
            "@/actions/Laravel/Passkeys/Http/Controllers/PasskeyRegistrationController": ["src/platform/passkey-management-actions.ts"],
            "@/actions/Laravel/Passkeys/Http/Controllers/PasskeyConfirmationController": ["src/platform/passkey-confirmation-actions.ts"],
            "@/actions/App/Http/Controllers/Settings/SecurityController": ["src/platform/security-actions.ts"],
            "@/hooks/use-two-factor-auth": ["src/platform/security-two-factor-auth.ts"],
            "@/routes/password/confirm": ["src/platform/password-confirm-routes.ts"],
            "@/routes/two-factor/login": ["src/platform/two-factor-routes.ts"],
            "@/routes/two-factor": ["src/platform/two-factor-management-routes.ts"],
            "@/routes/settings/sound-preferences": ["src/platform/sound-preferences-routes.ts"],
            "@/routes/login": ["src/platform/auth-routes.ts"],
            "@/routes/register": ["src/platform/register-routes.ts"],
            "@/routes/password": ["src/platform/auth-routes.ts"],
            "@/theme/appearance-persistence": ["src/platform/appearance-persistence.ts"],
            "@/actions/App/Http/Controllers/Settings/ProfileController": ["src/platform/profile-actions.ts"],
            "@/lib/media-upload": ["src/platform/profile-media-upload.ts"],
            "@/routes/verification": ["src/platform/verification-routes.ts"],
            "@inertiajs/react": ["src/platform/welcome-inertia.tsx"],
            "@/routes": ["src/platform/welcome-routes.ts"],
            "@/*": ["canonical-source/resources/js/*"]
        }
  },
  "include": ["src"]
}
